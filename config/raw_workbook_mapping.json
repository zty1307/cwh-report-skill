{
  "version": 2,
  "channel_display_labels": {
    "domestic_mainstream": "境内主流媒体"
  },
  "channel_display_label_basis": "2026-09-21用户确认：以细分渠道-日趋势为统计来源；境内主流媒体只取境内新闻-境内新闻，百家号、头条归新媒体。保留来源字段和归并审计，不根据历史人工调整值平衡渠道。",
  "file_patterns": {
    "total_heat": "^总[0-9]+-.*热度分析\\.xlsx$",
    "child_heat": "^子([1-9][0-9]*)(?:-|\\.xlsx$).*(?:热度分析\\.xlsx)?$",
    "public_top": "^总[0-9]+-.*公众文章.*样本\\.xlsx$",
    "overseas_latest": "^总[0-9]+-.*境外新闻.*样本\\.xlsx$"
  },
  "input_role_hints": {
    "total_heat": ["总事件", "总体", "汇总", "overall", "total"],
    "child_index_patterns": [
      "(?:^|[^0-9])子(?:事件|议题)?\\s*[-_]?\\s*([1-9][0-9]*)",
      "(?:^|[^a-z0-9])(?:subevent|subtopic|topic)\\s*[-_]?\\s*([1-9][0-9]*)",
      "^\\s*([1-9][0-9]*)\\s*(?:[-_.（(]|$)"
    ]
